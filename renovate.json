{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting"
  ],
  "prCreation": "immediate",
  "automerge": false,
  "platformAutomerge": false,
  "enabledManagers": [
    "custom.regex"
  ],
  "ignorePaths": [
    "apps/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Read Docker images only from current Compose manifests",
      "managerFilePatterns": [
        "/^\\.renovate/current/[^/]+\\.json$/"
      ],
      "matchStrings": [
        "\\\"service\\\"\\s*:\\s*\\\"(?<depType>[^\\\"]+)\\\"\\s*,\\s*\\\"repository\\\"\\s*:\\s*\\\"(?<depName>[^\\\"]+)\\\"\\s*,\\s*\\\"tag\\\"\\s*:\\s*\\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "One current Compose manifest per branch and pull request",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        ".renovate/current/*.json"
      ],
      "groupName": "compose {{{packageFile}}}",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "postUpgradeTasks": {
        "commands": [
          "node .github/scripts/renovate/post-upgrade.mjs"
        ],
        "dataFileTemplate": "{{{toJSON upgrades}}}",
        "executionMode": "branch",
        "fileFilters": [
          ".renovate/current/**",
          "apps/**"
        ]
      }
    }
  ]
}
