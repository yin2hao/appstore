{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base"],
  "prHourlyLimit": 10,
  "gitIgnoredAuthors": [
    "githubaction@githubaction.com"
  ],
  "rebaseWhen": "never",
  "ignorePaths": [
    "apps/mysql-cluster/**",
    "apps/redis-cluster/**",
    "apps/postgresql-cluster/**"
  ],
  "packageRules": [
    {
      "packageNames": ["docker-compose"],
      "automerge": false
    }
  ],
  "prCreation": "immediate",
  "platformAutomerge": false
}
