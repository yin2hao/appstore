{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableRateLimiting"
  ],
  "prCreation": "immediate",
  "automerge": true,
  "platformAutomerge": true,
  "recreateWhen": "always",
  "branchConcurrentLimit": 0,
  "prConcurrentLimit": 0,
  "enabledManagers": [
    "custom.regex"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Read Docker images only from runtime-selected current Compose manifests",
      "managerFilePatterns": [
        "/^apps\\/[^/]+\\/[^/]+\\/docker-compose\\.yml$/"
      ],
      "matchStrings": [
        "\\n {2}(?<depType>[A-Za-z0-9_-]+):[ \\t]*\\r?\\n(?: {4}[^\\r\\n]*\\r?\\n)*? {4}image:[ \\t]*(?<depName>[^\\s:@]+(?:/[^\\s:@]+)*):(?<currentValue>[^\\s@]+)"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "One runtime-selected Compose release per branch and pull request",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "apps/*/*/docker-compose.yml"
      ],
      "groupName": "{{{replace '^apps/([^/]+)/.*$' '$1' packageFile}}} tag",
      "groupSingleUpdates": true,
      "separateMajorMinor": false,
      "separateMinorPatch": false,
      "postUpgradeTasks": {
        "commands": [
          "node .github/scripts/renovate/post-upgrade.mjs"
        ],
        "dataFileTemplate": "{{{toJSON upgrades}}}",
        "executionMode": "branch",
        "fileFilters": [
          "apps/**"
        ]
      }
    }
  ]
}
